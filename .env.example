# Copy to .env for local testing. On Render, add each of these under
# Environment -> Environment Variables instead (never commit real values).

# --- Aiven MySQL credentials (Aiven console -> your service -> Overview) ---
DB_HOST=mysql-xxxx-yourproject.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb

# DISABLED | REQUIRED (encrypted, no cert check) | VERIFY (needs DB_SSL_CA)
DB_SSL_MODE=REQUIRED
# Only for VERIFY: paste the full contents of Aiven's ca.pem here
DB_SSL_CA=

# --- App settings ---
MODEL_PATH=models/best.onnx
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45
# Comma-separated list of frontend origins, or * while testing
CORS_ORIGINS=*
